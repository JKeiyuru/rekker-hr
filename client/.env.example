# client/.env.example
# Copy this file to ".env" in the same folder if you need to override the
# API URL locally. You usually DON'T need this file for local development -
# Vite's dev-server proxy (see vite.config.js) already forwards /api to
# http://localhost:5000 for you.
#
# You DO need this - as an actual Environment Variable set in your hosting
# provider's dashboard (not a committed .env file) - once the frontend is
# deployed as a static site, because there's no dev-server proxy anymore:
#
#   VITE_API_URL=https://your-backend-service.onrender.com/api
#
# Leave it unset locally and it falls back to the relative "/api" path,
# which the Vite proxy handles.
VITE_API_URL=
