# server/.env.example
# Copy this file to ".env" in the same folder and fill in real values.

# Local MongoDB (default if you installed MongoDB Community Server locally)
MONGO_URI=mongodb://127.0.0.1:27017/rekker-hr

# Or a MongoDB Atlas connection string, e.g.:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/rekker-hr

PORT=5000
NODE_ENV=development

# Change this to a long random string before going to production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# The URL your React app runs on (Vite default)
CLIENT_URL=http://localhost:5173
